# Copy to an external restricted-permission file; never store live secrets here.
APP_VERSION=replace-with-full-git-sha
BACKEND_IMAGE=classroom-annotator-backend:replace-with-full-git-sha
FRONTEND_IMAGE=classroom-annotator-frontend:replace-with-full-git-sha
APP_DATA_VOLUME=classroom-app
PROMETHEUS_DATA_VOLUME=classroom-prometheus
GRAFANA_DATA_VOLUME=classroom-grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
APP_PORT=8180
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
APP_MAX_UPLOAD_BYTES=524288000
APP_QUEUE_SIZE=8
APP_JOB_TIMEOUT_SECONDS=600
APP_MAX_FRAMES=1000
APP_HTTP_TIMEOUT_SECONDS=30
APP_DATASET_API_URL=
APP_DATASET_ID=
APP_DATASET_API_KEY=
APP_ALLOWED_PRIVATE_ORIGINS=
APP_ALLOWED_MEDIA_ORIGINS=
# P1: combine base, postgres and same-host sources; use TLS overlay on cloud.
# DDL credentials are used only by migrate/import CLI; server uses DML credentials.
APP_DATABASE_URL=
APP_DB_MAX_OPEN_CONNS=5
APP_DB_MAX_IDLE_CONNS=2
APP_DB_CONNECT_TIMEOUT_SECONDS=5
APP_DB_QUERY_TIMEOUT_SECONDS=10
APP_DB_CONN_MAX_LIFETIME_SECONDS=1800
APP_DB_CONN_MAX_IDLE_SECONDS=300
POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:66aafa11cf15800a3c94763f7e11d1e7b2e37e5e84bc4ce027cb6e1e4bfaf4df
POSTGRES_DATA_VOLUME=classroom-postgres
POSTGRES_ENV_FILE=
# Public catalog/media, authorized local sources and model stay outside code.
PUBLIC_SAMPLE_DIRECTORY=
LOCAL_SOURCE_DIRECTORY=
APP_AUTH_INVITE_CODE=
APP_AUTH_TRUSTED_ORIGINS=https://replace-with-host
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_TRUSTED_PROXIES=
AI_IMAGE=classroom-annotator-ai:replace-with-full-git-sha
AI_MODEL_DIRECTORY=
AI_TOKEN_HOST_FILE=
AI_INTERNAL_TOKEN=
APP_AI_URL=http://ai:8090
# Optional whole-document help; add compose.help.yml only when configured.
APP_HELP_API_URL=
APP_HELP_MODEL=glm-4.7-flash
APP_HELP_API_KEY_FILE=
HELP_API_KEY_HOST_FILE=
APP_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=1800
TLS_BUNDLE_DIRECTORY=
ACME_WEBROOT_DIRECTORY=
# Verified source manifest digests. Offline docker-load may require exact tags
# instead; record loaded image config IDs and source digests in release evidence.
RUNTIME_IMAGE=debian:bookworm-slim@sha256:a4672c0cb26fbdde88e38fa2dfb6c681942306680e41e4378b28770b6e79ee91
NGINX_IMAGE=nginx:1.28.0@sha256:3b03dfd827515a07ccf4946000f0bbdd2a4fb6aca7499249fcb6b1f9726823d6
PROMETHEUS_IMAGE=prom/prometheus:v3.2.1@sha256:5d34817348f69ddb956be509cafa4d4c2b5ecbbb5b786dd99d5a62e686b2ece4
GRAFANA_IMAGE=grafana/grafana:11.6.0@sha256:b739cda4b61ba3b90707578b643a22cd851fecf4498e6c6ec2d8f9d622a5d0b2
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1@sha256:863b62ff9f392b6f472e22b4b670ad1cabb66b3042502ebd4b2cd192733e1bce
